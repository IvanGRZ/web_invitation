---
// Gesto de desplazamiento: línea dorada por la que cae una estela de luz hacia una flecha que rebota.
// Es un enlace real a la siguiente pantalla. CSS puro, sin isla.
// Medidas en unidades de diseño (--u); el retraso de aparición se ajusta con --cue-delay (por defecto 3.6s).

/**
 * @typedef {Object} Props
 * @property {string} href ancla de la siguiente pantalla
 * @property {string} [label] nombre accesible
 * @property {string} [texto] palabra que guía ("Desliza"): se prende y se apaga al ritmo de la flecha
 * @property {string} [class]
 */

const { href, label = 'Ver detalles', texto, class: className } = /** @type {Props} */ (Astro.props);
---

<a href={href} aria-label={label} class:list={['scroll-cue', texto && 'scroll-cue--texto', className]}>
	{texto && <span class="scroll-cue__texto" aria-hidden="true">{texto}</span>}
	<span class="scroll-cue__line" aria-hidden="true"><span class="scroll-cue__trail"></span></span>
	<svg class="scroll-cue__chevron" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M5 9l7 7 7-7"></path>
	</svg>
</a>

<style>
	.scroll-cue {
		--uu: var(--u, 1px);

		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
		width: max(44px, calc(56 * var(--uu)));
		height: max(44px, calc(62 * var(--uu)));
		color: var(--gold);
		text-decoration: none;
		opacity: 0;
		animation: cue-in 1s ease var(--cue-delay, 3.6s) forwards;
	}

	.scroll-cue:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 4px;
		border-radius: var(--radius-pill);
	}

	/* Con palabra (Ivan, 25 nov): una estela larga con la palabra en su mitad y la flecha al final. La luz cae por la
	   línea (que nace difuminada), pasa por detrás de la palabra (la línea tiene un hueco ahí) y la palabra se
	   enciende cuando la cruza.
	   La flecha sube sobre el aire vacío de su propio dibujo (el trazo ocupa sólo el centro de su caja). */
	.scroll-cue--texto {
		--cue-linea: 64;
		--cue-hueco: 30;

		position: relative;
		width: max(44px, calc(120 * var(--uu)));
		height: auto;
	}

	/* Estela más gruesa y un poco más visible que la del gesto solo (Ivan, 25 nov: "quiero ver algo"). */
	.scroll-cue--texto .scroll-cue__line,
	.scroll-cue--texto .scroll-cue__trail {
		width: 2px;
	}

	.scroll-cue--texto .scroll-cue__line {
		--h: calc(var(--cue-hueco) * var(--uu) / 2);

		background: rgba(201, 168, 110, 0.24);

		-webkit-mask: linear-gradient(transparent, #000 calc(12 * var(--uu)) calc(50% - var(--h)), transparent 0 calc(50% + var(--h)), #000 0);
		mask: linear-gradient(transparent, #000 calc(12 * var(--uu)) calc(50% - var(--h)), transparent 0 calc(50% + var(--h)), #000 0);
	}

	.scroll-cue__texto {
		position: absolute;
		left: 50%;
		top: calc(var(--cue-linea) * var(--uu) / 2);
		transform: translate(-50%, -50%);
		padding-left: 0.32em; /* compensa el espaciado de la última letra: la palabra queda centrada en la línea */
		font-family: var(--font-sans);
		font-size: max(11px, calc(12 * var(--uu)));
		font-weight: 500;
		line-height: 1;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--gold-deep);
		opacity: 0.6; /* atenuada, sigue con contraste de 4.8:1 sobre la noche */
		animation: cue-pulso 2.4s ease-in-out var(--cue-delay, 3.6s) infinite;
	}

	.scroll-cue--texto .scroll-cue__chevron {
		width: calc(36 * var(--uu));
		height: calc(36 * var(--uu));
		margin-top: calc(-13 * var(--uu));
	}

	.scroll-cue__line {
		position: relative;
		display: block;
		width: 1px;
		height: calc(var(--cue-linea, 32) * var(--uu));
		overflow: hidden;
		background: rgba(201, 168, 110, 0.16);
	}

	.scroll-cue__trail {
		position: absolute;
		left: 0;
		top: 0;
		width: 1px;
		height: calc(20 * var(--uu));
		background: linear-gradient(180deg, rgba(232, 207, 156, 0) 0%, var(--gold-deep) 100%);
		transform: translateY(calc(-20 * var(--uu)));
		animation: cue-trail 2.4s cubic-bezier(0.6, 0, 0.4, 1) var(--cue-delay, 3.6s) infinite;
	}

	.scroll-cue__chevron {
		width: calc(30 * var(--uu));
		height: calc(30 * var(--uu));
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
		animation: cue-bob 2.4s ease-in-out var(--cue-delay, 3.6s) infinite;
	}

	@keyframes cue-in {
		to {
			opacity: 1;
		}
	}

	@keyframes cue-trail {
		0% {
			transform: translateY(calc(-20 * var(--uu)));
		}
		70%,
		100% {
			transform: translateY(calc(var(--cue-linea, 32) * var(--uu)));
		}
	}

	/* La palabra se enciende cuando la luz pasa por detrás de ella (a la mitad de su caída) y se vuelve a atenuar. */
	@keyframes cue-pulso {
		0%,
		70%,
		100% {
			opacity: 0.6;
		}
		35% {
			opacity: 1;
		}
	}

	@keyframes cue-bob {
		0%,
		45%,
		100% {
			transform: translateY(0);
		}
		65% {
			transform: translateY(calc(5 * var(--uu)));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-cue {
			animation: none;
			opacity: 1;
		}

		.scroll-cue__trail {
			animation: none;
			transform: none;
		}

		.scroll-cue__chevron,
		.scroll-cue__texto {
			animation: none;
		}

		.scroll-cue__texto {
			opacity: 1;
		}
	}
</style>
