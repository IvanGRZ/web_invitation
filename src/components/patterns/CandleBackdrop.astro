---
// Fondo "luz de velas" (tema noche): degradado radial, ikat que se desliza, luz que respira,
// halos índigo y destellos flotantes. Decorativo, va en el slot `fondo` de una pantalla.
//
// El degradado y el ikat llenan toda la pantalla; la luz, los halos y los destellos se colocan sobre
// el tablero (mismo rectángulo que .screen__escenario), en unidades de diseño (--u).
// La composición (forma del degradado, luz, halos, destellos) llega por props desde los datos de la pantalla.
// Colores por tokens (--paper, --paper-deep, --candle, --rose); --candle-from ajusta el inicio del degradado.

/**
 * @typedef {Object} Luz
 * @property {number} top px del tablero
 * @property {number} size px del tablero
 * @property {number} alpha opacidad del centro
 */
/**
 * @typedef {Object} Halo
 * @property {number} [left] @property {number} [right] @property {number} [top] @property {number} [bottom]
 * @property {number} size px del tablero
 * @property {number} alpha opacidad del centro
 */
/**
 * @typedef {Object} Destello
 * @property {number} [left] @property {number} [right]
 * @property {number} top
 * @property {number} size
 * @property {'candle' | 'rose'} [color]
 * @property {number} blur
 * @property {number} opacity
 * @property {number} [duration] segundos (por defecto 9)
 * @property {number} [delay] segundos
 */
/**
 * @typedef {Object} Props
 * @property {string} [forma] tamaño del degradado radial (p. ej. "120% 70%")
 * @property {Luz} luz
 * @property {Halo[]} halos
 * @property {Destello[]} destellos
 * @property {string} [class]
 */

const { forma = '120% 70%', luz, halos, destellos, class: className } = /** @type {Props} */ (Astro.props);

/** @param {number} n */
const u = (n) => `calc(${n} * var(--uu))`;

/** @param {Record<string, number | undefined>} lados */
const lados = (lados) =>
	Object.entries(lados)
		.filter(([, v]) => v !== undefined)
		.map(([lado, v]) => `${lado}:${u(/** @type {number} */ (v))}`);

const estiloFondo = `background:radial-gradient(${forma} at 50% 0%, var(--candle-from, var(--linen)) 0%, var(--paper) 60%, var(--paper-deep) 100%)`;

const estiloLuz = [
	`top:${u(luz.top)}`,
	`width:${u(luz.size)}`,
	`height:${u(luz.size)}`,
	`background:radial-gradient(circle, rgba(201,168,110,${luz.alpha}) 0%, rgba(201,168,110,0.12) 38%, rgba(201,168,110,0) 70%)`,
].join(';');

/** @param {Halo} h */
const estiloHalo = (h) =>
	[
		...lados({ left: h.left, right: h.right, top: h.top, bottom: h.bottom }),
		`width:${u(h.size)}`,
		`height:${u(h.size)}`,
		`background:radial-gradient(circle, rgba(47,74,120,${h.alpha}) 0%, rgba(47,74,120,0) 70%)`,
	].join(';');

/** @param {Destello} d */
const estiloDestello = (d) =>
	[
		...lados({ left: d.left, right: d.right, top: d.top }),
		`width:${u(d.size)}`,
		`height:${u(d.size)}`,
		`background:var(--${d.color ?? 'candle'})`,
		`filter:blur(${u(d.blur)})`,
		`opacity:${d.opacity}`,
		`animation-duration:${d.duration ?? 9}s`,
		`animation-delay:${d.delay ?? 0}s`,
	].join(';');
---

<div class:list={['candle', className]} style={estiloFondo} aria-hidden="true">
	<div class="candle__ikat"></div>
	<div class="candle__tablero">
		<div class="candle__luz" style={estiloLuz}></div>
		{halos.map((h) => <div class="candle__halo" style={estiloHalo(h)} />)}
		{destellos.map((d) => <span class="candle__destello" style={estiloDestello(d)} />)}
	</div>
</div>

<style>
	.candle {
		--uu: var(--u, 1px);

		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.candle__ikat {
		position: absolute;
		inset: 0;
		opacity: var(--opacity-ikat);
		background-image: url('/ikat-textura-marfil.svg');
		background-size: calc(96 * var(--uu)) calc(96 * var(--uu));
		animation: candle-drift 60s linear infinite;
	}

	/* Mismo rectángulo que el tablero de la pantalla. */
	.candle__tablero {
		position: absolute;
		left: 50%;
		top: 50%;
		width: calc(var(--bw, 390) * var(--uu));
		height: calc(var(--bh, 844) * var(--uu));
		transform: translate(-50%, -50%);
	}

	.candle__luz {
		position: absolute;
		left: 50%;
		border-radius: var(--radius-oval);
		transform: translateX(-50%);
		animation: candle-breathe 7s ease-in-out infinite;
	}

	.candle__halo {
		position: absolute;
		border-radius: var(--radius-oval);
	}

	.candle__destello {
		position: absolute;
		border-radius: var(--radius-oval);
		animation-name: candle-float;
		animation-timing-function: ease-in-out;
		animation-iteration-count: infinite;
	}

	@keyframes candle-drift {
		to {
			background-position: calc(192 * var(--uu)) calc(96 * var(--uu));
		}
	}

	@keyframes candle-breathe {
		0%,
		100% {
			opacity: 0.75;
			transform: translateX(-50%) scale(1);
		}
		50% {
			opacity: 1;
			transform: translateX(-50%) scale(1.08);
		}
	}

	@keyframes candle-float {
		0%,
		100% {
			transform: translate(0, 0);
		}
		50% {
			transform: translate(calc(8 * var(--uu)), calc(-22 * var(--uu)));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.candle__ikat,
		.candle__luz,
		.candle__destello {
			animation: none;
		}
	}
</style>
