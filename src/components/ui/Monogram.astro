<style>
	.monogram {
		overflow: visible;
		height: auto;
	}

	.monogram--draw .trazo {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		animation: mono-trazo var(--mono-draw-duration, 2.2s) cubic-bezier(0.65, 0, 0.35, 1) var(--mono-draw-delay, 0.4s) forwards;
	}

	.monogram--draw .trazo--tarde {
		animation-duration: var(--mono-late-duration, 1.5s);
		animation-delay: var(--mono-late-delay, 1s);
	}

	.monogram--draw .ornamentos {
		opacity: 0;
		animation: mono-aparece 1.2s ease var(--mono-ornaments-delay, 1.7s) forwards;
	}

	.monogram--draw .letras {
		opacity: 0;
		filter: blur(6px);
		animation: mono-enfoque 1.4s ease var(--mono-letters-delay, 1.3s) forwards;
	}

	@keyframes mono-trazo {
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes mono-aparece {
		to {
			opacity: 1;
		}
	}

	@keyframes mono-enfoque {
		to {
			opacity: 1;
			filter: blur(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.monogram--draw .trazo {
			animation: none;
			stroke-dashoffset: 0;
		}

		.monogram--draw .ornamentos,
		.monogram--draw .letras {
			animation: none;
			opacity: 1;
			filter: none;
		}
	}
</style>
