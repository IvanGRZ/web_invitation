---
// Monograma I & E (trazos de design/reference/portada.html).
// Toma el color de `currentColor`: el contenedor decide el tono.
// Con `draw`, los óvalos se dibujan trazo a trazo, los ornamentos aparecen y las letras se enfocan.
// Los tiempos se ajustan desde fuera con variables CSS (--mono-*), por defecto los de la portada aprobada.

/**
 * @typedef {Object} Props
 * @property {boolean} [draw] anima la entrada (respeta prefers-reduced-motion)
 * @property {string} [title] nombre accesible
 * @property {string} [class]
 */

const { draw = false, title = 'Monograma I y E', class: className, ...rest } = /** @type {Props & Record<string, unknown>} */ (Astro.props);
