---
// Muestras de la confirmación con los datos del lienzo ("Familia García", 4 lugares), SÓLO en desarrollo
// (en el build no se genera ninguna). Sirven para revisar cada paso y estado mientras no exista el backend
// y para la comparación con el lienzo (tools/qa/casos.mjs):
//   /prueba/pasos/confirmar           pasos 1 → 3 y gracias (guardar siempre funciona)
//   /prueba/pasos-1 … pasos-6         lo mismo con pases de 1 a 6 lugares
//   /prueba/falla/confirmar           el primer intento de guardar falla (error al guardar)
//   /prueba/candado/confirmar         el candado; K7M2-PQ9X es el código válido, cualquier otro es inválido
//   /prueba/invalido/confirmar        el candado con un código inválido
//   /prueba/error/confirmar           el paso del mensaje con el error al guardar
//   /prueba/regreso[-no]/confirmar    la familia ya respondió (que sí / que no)
//   /prueba/cerrada[-sin]/confirmar   pasó la fecha límite (con su respuesta / sin respuesta)
import Recorrido from '@/layouts/Recorrido.astro';
import { confirmacion, tituloDe } from '@/screens/index.js';
import { muestra } from '@/screens/confirmacion/confirmacion.data.js';

export function getStaticPaths() {
	if (import.meta.env.PROD) return [];
	const { respuesta, codigoValido, codigoInvalido } = muestra;
	const pasos = (lugares) => ({ estado: 'pasos', lugares });
	/** @type {Record<string, Record<string, unknown>>} */
	const muestras = {
		pasos: pasos(4),
		...Object.fromEntries([1, 2, 3, 4, 5, 6].map((l) => [`pasos-${l}`, pasos(l)])),
		falla: { estado: 'pasos', simular: { fallarGuardado: true } },
		candado: { estado: 'candado', simular: { codigoValido, destinoValido: '/prueba/pasos/confirmar' } },
		invalido: {
			estado: 'candado',
			simular: { codigoValido, destinoValido: '/prueba/pasos/confirmar' },
			inicio: { codigo: codigoInvalido, codigoInvalido: true },
		},
		error: { estado: 'pasos', inicio: { vista: 'p2', n: 3, mensaje: respuesta.mensaje, error: true } },
		regreso: { estado: 'regreso', respuesta },
		'regreso-no': { estado: 'regreso', respuesta: { ...respuesta, asiste: false, invitados: 0, mensaje: undefined } },
		cerrada: { estado: 'cerrada', respuesta },
		'cerrada-sin': { estado: 'cerrada', respuesta: null },
	};
	return Object.entries(muestras).map(([estado, props]) => ({ params: { estado }, props }));
}

const base = `/prueba/${Astro.params.estado}`;
const { Componente } = confirmacion;
---

<Recorrido title={tituloDe(confirmacion)} description="Muestra de desarrollo" base={base} inicial={confirmacion.slug} theme="marfil" noindex>
	<Componente
		id={confirmacion.id}
		slug={confirmacion.slug}
		titulo={tituloDe(confirmacion)}
		volver="/portada"
		destinoCodigo="/i/{codigo}/confirmar"
		familia={muestra.familia}
		lugares={Astro.props.lugares ?? muestra.lugares}
		{...Astro.props}
	/>
</Recorrido>
