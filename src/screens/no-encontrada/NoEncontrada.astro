---
// Pantalla general · 404 (código inexistente). docs/pantallas.md § 6.8.
// Tableros del lienzo: General404 (celular 390×844) y General404-escritorio (computadora 1440×900).
// Estilos en no-encontrada.css; composición del fondo en no-encontrada.data.js.
//
// De noche, con el medallón chico, los nombres y "No encontramos esta invitación". Sirve para un
// `/i/<codigo>` inexistente y para cualquier ruta que no exista. "Escribir mi código" lleva al candado
// de la confirmación (§ 6.7); "Ver la invitación", a la invitación general. Al pie, la ayuda por WhatsApp.
import Screen from '@/components/patterns/Screen.astro';
import CandleBackdrop from '@/components/patterns/CandleBackdrop.astro';
import Medallion from '@/components/patterns/Medallion.astro';
import Button from '@/components/ui/Button.astro';
import { evento } from '@/config/evento.js';
import { fondoCelular, fondoComputadora } from './no-encontrada.data.js';
import './no-encontrada.css';

/**
 * @typedef {Object} Props
 * @property {string} id ancla de la pantalla (lo da screens/index.js)
 * @property {string} slug segmento de su ruta (lo da screens/index.js)
 * @property {string} titulo título de la pestaña (lo da screens/index.js)
 * @property {string} codigo dirección del candado ("Escribir mi código")
 * @property {string} invitacion dirección de la invitación general ("Ver la invitación")
 */

const { id, slug, titulo, codigo, invitacion } = /** @type {Props} */ (Astro.props);
const { el, ella } = evento.novios;
const whatsapp = `https://wa.me/${evento.whatsapp ?? ''}`;
---

<Screen id={id} slug={slug} titulo={titulo} theme="noche" class="no-encontrada" aria-labelledby="no-encontrada-titulo">
	<Fragment slot="fondo">
		<div class="no-encontrada__fondo no-encontrada__fondo--celular">
			<CandleBackdrop {...fondoCelular} />
		</div>
		<div class="no-encontrada__fondo no-encontrada__fondo--computadora">
			<CandleBackdrop {...fondoComputadora} />
		</div>
	</Fragment>

	<div class="no-encontrada__medallon">
		<Medallion />
	</div>

	<p class="no-encontrada__nombres no-encontrada__entra">{el.nombre} &amp; {ella.nombre}</p>
	<h1 id="no-encontrada-titulo" class="no-encontrada__titulo no-encontrada__entra">No encontramos esta invitación</h1>
	<p class="no-encontrada__texto no-encontrada__entra">
		Puede que el enlace esté incompleto o que el código haya cambiado. Con tu código entras directo a la tuya.
	</p>

	<div class="no-encontrada__acciones no-encontrada__entra">
		<Button href={codigo} block>Escribir mi código</Button>
		<a class="no-encontrada__enlace" href={invitacion}>Ver la invitación</a>
	</div>

	<p class="no-encontrada__ayuda no-encontrada__entra">
		¿Necesitas ayuda?{' '}<a class="no-encontrada__enlace" href={whatsapp} target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>
	</p>
</Screen>
