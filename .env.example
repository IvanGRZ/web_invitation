# Copia este archivo como .env (o .env.local) y pon los valores. En Netlify van en Site configuration › Environment variables.
# Nunca subas los valores al repo.

# URL del proyecto de Supabase (Project Settings › API)
SUPABASE_URL=
# Llave SECRETA del servidor: service_role o sb_secret_… (nunca la anon / publishable)
SUPABASE_SERVICE_ROLE_KEY=